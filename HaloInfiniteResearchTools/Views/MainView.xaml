<views:ViewBase x:Class="HaloInfiniteResearchTools.Views.MainView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:views="clr-namespace:HaloInfiniteResearchTools.Views"
            xmlns:m="clr-namespace:HaloInfiniteResearchTools.Models"
            xmlns:vm="clr-namespace:HaloInfiniteResearchTools.ViewModels"
            xmlns:vmo="clr-namespace:HaloInfiniteResearchTools.ViewModels.Online"
            xmlns:controls="clr-namespace:HaloInfiniteResearchTools.Controls"
            mc:Ignorable="d" 
            d:DesignHeight="720" d:DesignWidth="1280"
            UseLayoutRounding="True"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            SnapsToDevicePixels="True"
            RenderOptions.ClearTypeHint="Enabled">
    <Grid Background="{DynamicResource Brush.Deep.2.Background.Static}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="Open File"
                          Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open Directory"
                          Command="{Binding OpenDirectoryCommand}" />
                <MenuItem Header="Open From Runtime"
                          Command="{Binding OpenFromRuntimeCommand}" />
                <MenuItem Header="Reset"
                          Command="{Binding ResetSessionCommand}" />

            </MenuItem>
            <MenuItem Header="Views">
                <MenuItem Header="Grettings"
                          Command="{Binding OpenViewSaludosCommand}" />
                <MenuItem Header="Online"
                          Command="{Binding OpenViewOnlineCommand}" />
                <MenuItem Header="Ripping"
                          Command="{Binding OpenViewRippingCommand}" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Tag Template Dumper" Command="{Binding TagStructsDumperCommand}" />
                <MenuItem Header="Tag Template Load all" Command="{Binding TagStructsLoadAllCommand}" />
                <Separator />
                <MenuItem Header="Binary Explorer" Command="{Binding BinaryExplorerCommand}" />
                <MenuItem Header="Tools" Command="{Binding ToolsCommand}" />
                <Separator />
                <MenuItem Header="Bulk Export Models" Command="{Binding BulkExportModelsCommand}" IsEnabled="False" />
                <MenuItem Header="Bulk Export Textures" Command="{Binding BulkExportTexturesCommand}" IsEnabled="False"/>
                <Separator />
                <MenuItem Header="Preferences" Command="{Binding EditPreferencesCommand}" />
            </MenuItem>
            <MenuItem Header="Help" >
                <MenuItem Header="Tutorial Video" IsEnabled="true"
                          Command="{Binding ShowWebPageCommand}"
                          CommandParameter="https://www.youtube.com/watch?v=n2BYuAeiXgc" />
                <MenuItem Header="GitHub" IsEnabled="true"
                          Command="{Binding ShowWebPageCommand}"
                          CommandParameter="https://github.com/urium1186/HIRT"/>
                <MenuItem Header="Discord"
                          Command="{Binding ShowWebPageCommand}"
                          CommandParameter="https://discord.com/invite/haloarchive" />
                <Separator />
                <MenuItem Header="About" 
                          Command="{Binding ShowViewModalCommand}"
                          CommandParameter="{x:Type views:AboutView}" />
            </MenuItem>
        </Menu>
        <ContentControl Grid.Row="1" Visibility="{Binding ShowSaludos, Converter={StaticResource BoolVisibilityConverter}}" Name="Saludos" Content="{Binding SaludosViewModelP}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:SaludosViewModel}">
                    <views:SaludosView></views:SaludosView>
                </DataTemplate>
            </ContentControl.Resources>
                
            
            <!--<views:SaludosView></views:SaludosView>-->
        </ContentControl>
        <ContentControl Grid.Row="1" Visibility="{Binding ShowOnline, Converter={StaticResource BoolVisibilityConverter}}" Name="Online" Content="{Binding CustomOnlineViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vmo:CustomOnlineViewModel}">
                    <views:CustomOnlineView></views:CustomOnlineView>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
        <Grid Grid.Row="1" Visibility="{Binding ShowRiping, Converter={StaticResource BoolVisibilityConverter}}" Name="Riping">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="61.621" MaxWidth="400" />
                <ColumnDefinition Width="188.379"/>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <controls:FileTreeControl Grid.Column="0"
                                      FileDoubleClickCommand="{Binding OpenFileTabCommand}"
                                      FileTreeExportJsonCommand="{Binding FileTreeExportJsonCommand}"
                                      FileTreeExportRecursiveJsonCommand="{Binding FileTreeExportRecursiveJsonCommand}" Grid.ColumnSpan="2"
                                      />

            <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Stretch" />

            <TabControl Grid.Column="3"
                        DataContext="{Binding TabContext}"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding CurrentTab}">

                <TabControl.Resources>
                    <ContextMenu x:Key="TabCloseContex">
                        <MenuItem Header="Close All" Command="{Binding CloseAllTabCommand}"/>
                        <MenuItem Header="Close Others" Command="{Binding CloseOthersTabCommand}"/>
                        <MenuItem Header="Close all left" Command="{Binding CloseLeftTabCommand}"/>
                        <MenuItem Header="Close all right" Command="{Binding CloseRightTabCommand}"/>
                    </ContextMenu>
                </TabControl.Resources>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="{x:Type  TabItem}">
                        <Setter Property="ContextMenu" Value="{StaticResource TabCloseContex}" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>

                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:ITab}">
                        <Border CornerRadius="6,6,0,0" BorderBrush="Gray" Background="{DynamicResource TabItem.Selected.Background}" BorderThickness="1" DockPanel.Dock="Top">
                            <DockPanel Background="Transparent" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >

                                <DockPanel.InputBindings>
                                    <MouseBinding Command="{Binding CloseCommand}" Gesture="MiddleClick" />
                                </DockPanel.InputBindings>


                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                                <Button DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Right"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding CloseCommand}" >
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" HorizontalAlignment="Right">
                                                <Path Data="M0,0 L6,6 M6,0 L0,6" StrokeThickness="2" VerticalAlignment="Center" Margin="5,2,0,0" Stroke="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Static}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TreeViewItem.MouseOver.Border}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type m:ITab}">
                        <ContentPresenter Content="{Binding View}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>

            </TabControl>

        </Grid>

    </Grid>
</views:ViewBase>
