<views:View x:Class="HaloInfiniteResearchTools.Views.CustomOnlineView"
            x:TypeArguments="vm:CustomOnlineViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:views="clr-namespace:HaloInfiniteResearchTools.Views"
      xmlns:controls="clr-namespace:HaloInfiniteResearchTools.Controls"
      xmlns:vm="clr-namespace:HaloInfiniteResearchTools.ViewModels.Online"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      >
    <Grid x:Name="GrandParent" >
        <Grid Name="login"  Visibility="{Binding ShowLogin, Converter={StaticResource BoolVisibilityConverter}}">

            <Grid.RowDefinitions>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="350"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0B273C"/>
                    <GradientStop Color="#FF232137" Offset="0.25"/>
                    <GradientStop Color="#FF574D63" Offset="0.5"/>
                    <GradientStop Color="#FF232137" Offset="0.75"/>
                    <GradientStop Color="#FF0B273C"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid Grid.Column="0">


                <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/images/online_custom_banner.jpeg" Stretch="UniformToFill"/>




            </Grid>

            <Grid Grid.Column="2">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/images/login_bg_0.jpeg" Stretch="UniformToFill"/>
                </Grid.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="1">
                        <Button Template="{DynamicResource LoginButtonTemplate}"  Content="Go to Login"  Cursor="Hand" Command="{Binding ProcessLoginCommand}" Width="140" Height="45" BorderThickness="7,2,7,2" BorderBrush="{DynamicResource Brush.Border.Button.Gradien}" FontSize="18"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Grid>
        <Grid Name="CoresConfig"  Visibility="{Binding ShowList, Converter={StaticResource BoolVisibilityConverter}}">
            <TabControl ItemsSource="{Binding CoreItems}" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.ItemTemplate>
                    <!-- This is the header template-->
                    <DataTemplate>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Key.CoreId}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Button  Style="{DynamicResource ButtonRefresh}" Grid.Column="1" Width="25" Height="25" Command="{Binding DataContext.GetArmorCoreCommand, ElementName=GrandParent}" CommandParameter="{Binding Key}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Padding="0" Margin="0"
                                     Cursor="Hand">
                                <!--<TextBlock Text="⟲" HorizontalAlignment="Center" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="25"/>-->
                                <Image Height="20" Width="20" Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-refresh-40.png" AutomationProperties.HelpText="Reload"></Image>
                            </Button>
                        </Grid>

                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <!-- This is the body of the TabItem template-->
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                                <ItemsControl ItemsSource="{Binding DataContext.ItemsSelectedCore, ElementName=GrandParent}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <controls:OnlineItemControl Width="100" Height="125"  DataContext="{Binding Value}" />


                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Label Content="Name" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                    <TextBox Width="150" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="30"
                                             Text="{Binding DataContext.SelectedTabExtra.Name, ElementName=GrandParent}"></TextBox>
                                    <Button HorizontalAlignment="Right" Width="30" Height="30" ToolTip="Save"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SaveCoreToDbCommand, ElementName=GrandParent}" CommandParameter="{Binding Key}">
                                        <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-save-40.png"></Image>
                                    </Button>

                                </StackPanel>
                                <!--
                                <Button Content="Screen Capture" HorizontalAlignment="Right" Width="70" Height="28" Command="{Binding DataContext.CapturarPantallaCommand, ElementName=GrandParent}" ></Button>
                                <Image Source="{Binding DataContext.ImagenPath, ElementName=GrandParent}"/>
                                -->
                                <StackPanel Orientation="Horizontal">


                                </StackPanel>

                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="235"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Style="{DynamicResource DataGridCores}" Grid.Column="0" x:Name="dataGridThemes" AutoGenerateColumns="False" ItemsSource="{Binding DataContext.GetOnDbThems, ElementName=GrandParent}" 
                                          SelectionChanged="dataGridThemes_SelectionChanged" SelectionMode="Single" Width="275" AddingNewItem="dataGridThemes_AddingNewItem"
                                           
                                          >
                                    <DataGrid.Columns >
                                        <DataGridTemplateColumn Header="Imagen" Width="175">
                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate >
                                                    <StackPanel Orientation="Vertical">
                                                        <Image Source="{Binding ImagenSource}" Height="100"/>
                                                        <TextBlock Text="{Binding Texto}"  HorizontalAlignment="Center"></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!--<DataGridTextColumn Header="Name" Binding="{Binding Texto}"/>-->
                                        <DataGridTemplateColumn Header="Acción" Width="35">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center" >
                                                        <Button Height="30" Width="30" Command="{Binding DataContext.SaveThemeToCmsCommand, ElementName=GrandParent}" CommandParameter="{Binding Theme}"
                                                                ToolTip="Send to CMS" Cursor="Hand"
                                                                >
                                                            <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-paper-plane-40.png"></Image>
                                                        </Button>
                                                        <Button Height="30" Width="30" Command="{Binding DataContext.PreviewThemeToCmsCommand, ElementName=GrandParent}" CommandParameter="{Binding Theme}"
                                                                ToolTip="Preview" Cursor="Hand"
                                                                >
                                                            <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-eye-40.png"></Image>
                                                        </Button>
                                                        <!--
                                                        <Button Height="30" Width="30" Command="{Binding DataContext.UpdateThemeToCmsCommand, ElementName=GrandParent}" CommandParameter="{Binding Theme}"
                                                                ToolTip="Update" Cursor="Hand"
                                                                >
                                                            <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-save-40.png"></Image>
                                                        </Button>
                                                    -->
                                                        <Button Height="30" Width="30" Command="{Binding DataContext.DeleteThemeToCmsCommand, ElementName=GrandParent}" CommandParameter="{Binding Theme}"
                                                                ToolTip="Delete" Cursor="Hand"
                                                                >
                                                            <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-waste-40.png"></Image>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <Image Source="{Binding DataContext.PrevImageSource, ElementName=GrandParent}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></Image>


                                </StackPanel>
                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DataContext.ItemsRowSelectedTheme, ElementName=GrandParent}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <controls:OnlineItemControl Width="100" Height="125"  DataContext="{Binding Value}" />


                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

        </Grid>
    </Grid>
</views:View>
