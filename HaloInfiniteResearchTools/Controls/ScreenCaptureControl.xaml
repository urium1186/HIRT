<UserControl x:Class="HaloInfiniteResearchTools.Controls.ScreenCaptureControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto">
    <Grid>
        <Canvas Name="canvas" Background="Transparent"/>
        <Button Name="btnCapture" Click="btnCapture_Click">
            <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-screenshot-40.png"></Image>
        </Button>
    </Grid>
</UserControl>
