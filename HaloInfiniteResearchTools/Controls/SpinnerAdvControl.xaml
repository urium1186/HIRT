<UserControl x:Class="HaloInfiniteResearchTools.Controls.SpinnerAdvControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HaloInfiniteResearchTools.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="75">
    <Grid>
        <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/images/spinner/spinner_adv1_ru_border_circular.png" RenderTransformOrigin="0.5135,0.504" HorizontalAlignment="Center" VerticalAlignment="Center">
        </Image>
        <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/images/spinner/spinner_adv1_ru_0.png" RenderTransformOrigin="0.5135,0.504" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.RenderTransform>
                <RotateTransform x:Name="rotateTransform1"/>
            </Image.RenderTransform>
        </Image>
        <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/images/spinner/spinner_adv1_ru_1.png" RenderTransformOrigin="0.5135,0.504" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.RenderTransform>
                <RotateTransform x:Name="rotateTransform2"/>
            </Image.RenderTransform>
        </Image>
        <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/images/spinner/spinner_adv1_ru_2.png" RenderTransformOrigin="0.5135,0.504" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.RenderTransform>
                <RotateTransform x:Name="rotateTransform3"/>
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>
