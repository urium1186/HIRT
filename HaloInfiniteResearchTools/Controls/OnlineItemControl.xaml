<UserControl x:Class="HaloInfiniteResearchTools.Controls.OnlineItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HaloInfiniteResearchTools.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="75">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Source="{Binding ImageSource}"/>
        <TextBlock Grid.Row="1" Text="{Binding Description}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
