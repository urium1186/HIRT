<modal:WindowModal xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" x:Class="HaloInfiniteResearchTools.UI.Modals.GetImageModal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:modal="clr-namespace:HaloInfiniteResearchTools.UI.Modals"
       xmlns:controls="clr-namespace:HaloInfiniteResearchTools.Controls"
      
      mc:Ignorable="d" 
    ModalMaxHeight="480" ModalMinHeight="475" 
    ModalMaxWidth ="475" ModalMinWidth="220" 
      d:DesignHeight="450" d:DesignWidth="220"
                   VerticalAlignment="Center" HorizontalAlignment="Center">
    <modal:WindowModal.FooterButtons>
        <Button Content="Close" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </modal:WindowModal.FooterButtons>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" >
        <Grid.RowDefinitions>
            <RowDefinition Height="410"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0">
            <!--<Image Source="{Binding ImagenPath}" Visibility="{Binding UseImagenPath, Converter={StaticResource BoolVisibilityConverter}}" Stretch="UniformToFill"/>
            Visibility="{Binding NotUseImagenPath, Converter={StaticResource BoolVisibilityConverter}}" Stretch="UniformToFill"
            -->
            <Image Source="{Binding ScreenCaptureImageSource}"  />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Width="35" Height="35" Click="Button_Click" ToolTip="Find the image.">
                <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-add-image-40.png"></Image>
            </Button>
            <controls:ScreenCaptureControl x:Name="captureCoponent" Width="35" Height="35" ToolTip="Capture the image."/>
            <Button x:Name="save" Width="35" Height="35" Click="save_Click" ToolTip="Save the image.">
                <Image Source="pack://application:,,,/HaloInfiniteResearchTools;component/Resources/Icon/icons8-downloading-updates-40.png"></Image>
            </Button>
        </StackPanel>
    </Grid>
</modal:WindowModal>
